{
  "schema_version": 1,
  "profiles": {
    "pearlpool": {
      "url": "https://pearlhash.xyz/downloads/pearl-miner-v11",
      "archive": "file",
      "binary": "pearl-miner",
      "env": {
        "PEARLHASH_POOL_HOST": "84.32.220.219:9000"
      },
      "args": [
        "--host", "${PEARLHASH_POOL_HOST}",
        "--user", "${MINER_WALLET}",
        "--worker", "${WORKER_NAME}"
      ],
      "watchdog": {
        "mode": "log",
        "warmup_seconds": 180,
        "stale_seconds": 240,
        "hashrate_regexes": [
          {
            "regex": "Hashrate\\s+Total\\s*=\\s*([0-9]+(?:[.][0-9]+)?)\\s*([KMGT]?H/s)",
            "value_group": 1,
            "unit_group": 2
          }
        ],
        "error_regex": "cuda error|connection refused|failed|panic|segmentation fault"
      }
    },
    "tw-pool": {
      "url": "${TWPOOL_WRAPPER_URL}",
      "archive": "file",
      "binary": "twpool-lowhash-wrapper.py",
      "env": {
        "TWPOOL_WRAPPER_URL": "https://raw.githubusercontent.com/selkk-lab/pearl-fleet/main/scripts/twpool-lowhash-wrapper.py?v=20260608-urlarg1",
        "TWPOOL_MINER_URL": "https://github.com/egg5233/tw-pearl-miner/releases/download/v1.9.0/tw-pearl-miner-1.9.0-cuda12.tar.gz",
        "TWPOOL_LOW_HASH_ENABLED": "1",
        "TWPOOL_LOW_HASH_WARMUP_SECONDS": "600",
        "TWPOOL_LOW_HASH_RATIO": "0.55",
        "TWPOOL_LOW_HASH_BAD_SAMPLES": "3",
        "TWPOOL_LOW_HASH_MIN_BASELINE_TH_S": "50",
        "TWPOOL_LOW_HASH_RESTART_COOLDOWN_SECONDS": "900",
        "TWPOOL_HEARTBEAT_INTERVAL_SECONDS": "30"
      },
      "args": [
        "--twpool-miner-url", "${TWPOOL_MINER_URL}",
        "--",
        "--wallet", "${MINER_WALLET}",
        "--worker", "${WORKER_NAME}"
      ],
      "watchdog": {
        "mode": "log",
        "warmup_seconds": 90,
        "stale_seconds": 240,
        "hashrate_regexes": [
          {
            "regex": "([0-9]+(?:[.][0-9]+)?)\\s*([KMGT]?H/s)\\s+window",
            "value_group": 1,
            "unit_group": 2
          },
          {
            "regex": "([0-9]+(?:[.][0-9]+)?)\\s*([KMGT]?H/s)\\s+avg",
            "value_group": 1,
            "unit_group": 2
          }
        ],
        "accepted_count_regex": "shares:\\s*([0-9]+)\\s+accepted",
        "error_regex": "cuda error|connection refused|failed|panic|segmentation fault"
      }
    },
    "tw-pool-cuda12": {
      "url": "${TWPOOL_WRAPPER_URL}",
      "archive": "file",
      "binary": "twpool-lowhash-wrapper.py",
      "env": {
        "TWPOOL_WRAPPER_URL": "https://raw.githubusercontent.com/selkk-lab/pearl-fleet/main/scripts/twpool-lowhash-wrapper.py?v=20260608-urlarg1",
        "TWPOOL_MINER_URL": "https://github.com/egg5233/tw-pearl-miner/releases/download/v1.9.0/tw-pearl-miner-1.9.0-cuda12.tar.gz",
        "TWPOOL_LOW_HASH_ENABLED": "1",
        "TWPOOL_LOW_HASH_WARMUP_SECONDS": "600",
        "TWPOOL_LOW_HASH_RATIO": "0.55",
        "TWPOOL_LOW_HASH_BAD_SAMPLES": "3",
        "TWPOOL_LOW_HASH_MIN_BASELINE_TH_S": "50",
        "TWPOOL_LOW_HASH_RESTART_COOLDOWN_SECONDS": "900",
        "TWPOOL_HEARTBEAT_INTERVAL_SECONDS": "30"
      },
      "args": [
        "--twpool-miner-url", "${TWPOOL_MINER_URL}",
        "--",
        "--wallet", "${MINER_WALLET}",
        "--worker", "${WORKER_NAME}"
      ],
      "watchdog": {
        "mode": "log",
        "warmup_seconds": 90,
        "stale_seconds": 240,
        "hashrate_regexes": [
          {
            "regex": "([0-9]+(?:[.][0-9]+)?)\\s*([KMGT]?H/s)\\s+window",
            "value_group": 1,
            "unit_group": 2
          },
          {
            "regex": "([0-9]+(?:[.][0-9]+)?)\\s*([KMGT]?H/s)\\s+avg",
            "value_group": 1,
            "unit_group": 2
          }
        ],
        "accepted_count_regex": "shares:\\s*([0-9]+)\\s+accepted",
        "error_regex": "cuda error|connection refused|failed|panic|segmentation fault"
      }
    },
    "luckypool": {
      "url": "https://pearl.luckypool.io/lpminer/lpminer-0.1.9.tar.gz",
      "archive": "tar.gz",
      "binary": "lpminer",
      "env": {
        "MINER_POOL_URL": "stratum+tcp://pearl-eu2.luckypool.io:3360"
      },
      "args": [
        "--algo", "pearl",
        "--pool", "${MINER_POOL_URL}",
        "--wallet", "${MINER_WALLET}"
      ],
      "watchdog": {
        "mode": "log",
        "warmup_seconds": 90,
        "stale_seconds": 240,
        "hashrate_regexes": [
          {
            "regex": "^\\s*(?:GPU\\s+#\\d+|10s|60s|15m)\\b.*?([0-9]+(?:[.][0-9]+)?)\\s*([KMGT]?H/s)",
            "value_group": 1,
            "unit_group": 2
          }
        ],
        "accepted_regex": "share accepted",
        "rejected_regex": "share rejected|rejected",
        "error_regex": "connection refused|failed|panic|segmentation fault"
      }
    },
    "alphapool": {
      "url": "https://github.com/AlphaMine-Tech/alpha-miner/releases/latest/download/alpha-miner",
      "archive": "file",
      "binary": "alpha-miner",
      "env": {
        "MINER_POOL_URL": "stratum+tcp://us2.alphapool.tech:5566",
        "ALPHA_DIFFICULTY": "65536",
        "ALPHA_PASSWORD": "x;d=${ALPHA_DIFFICULTY}"
      },
      "args": [
        "--pool", "${MINER_POOL_URL}",
        "--address", "${MINER_WALLET}",
        "--worker", "${WORKER_NAME}",
        "--password", "${ALPHA_PASSWORD}"
      ],
      "watchdog": {
        "mode": "log",
        "warmup_seconds": 90,
        "stale_seconds": 240,
        "hashrate_regexes": [
          {
            "regex": "hashrate_th_s=([0-9]+(?:[.][0-9]+)?)",
            "value_group": 1,
            "unit": "TH/s"
          }
        ],
        "accepted_regex": "component=share\\s+submitted",
        "rejected_regex": "component=share\\s+rejected|rejected",
        "error_regex": "cuda error|connection refused|failed|panic|segmentation fault"
      }
    },
    "srbminer": {
      "url": "${SRB_WRAPPER_URL:-https://raw.githubusercontent.com/selkk-lab/pearl-fleet/main/scripts/srbminer-api-wrapper.sh}?v=20260608-srb335-stop1",
      "archive": "file",
      "binary": "srbminer-api-wrapper.sh",
      "env": {
        "MINER_POOL_URL": "pearl-eu2.luckypool.io:3360",
        "SRB_API_PORT": "21550",
        "SRBMINER_URL": "https://github.com/doktor83/SRBMiner-Multi/releases/download/3.3.5/SRBMiner-Multi-3-3-5-Linux.tar.gz",
        "SRB_WATCHDOG_WARMUP_SECONDS": "180",
        "SRB_WATCHDOG_STALE_SECONDS": "420",
        "SRB_WATCHDOG_CHECK_INTERVAL": "30",
        "SRB_WATCHDOG_MIN_HASHRATE_TH_S": "0.1",
        "SRB_SHUTDOWN_TERM_SECONDS": "8",
        "SRB_SHUTDOWN_KILL_SECONDS": "4"
      },
      "args": [
        "--algorithm", "pearlhash",
        "--pool", "${MINER_POOL_URL}",
        "--wallet", "${MINER_WALLET}",
        "--worker", "${WORKER_NAME}",
        "--disable-cpu",
        "--log-file", "/proc/self/fd/1",
        "--api-enable",
        "--api-port", "${SRB_API_PORT}"
      ],
      "watchdog": {
        "mode": "log",
        "warmup_seconds": 180,
        "stale_seconds": 600,
        "hashrate_regexes": [
          {
            "regex": "Total:\\s*([0-9]+(?:[.][0-9]+)?)\\s*([KMGT]?H/s)",
            "value_group": 1,
            "unit_group": 2
          }
        ],
        "accepted_count_regexes": [
          {
            "regex": "accepted=([0-9]+)",
            "group": 1
          }
        ],
        "rejected_count_regexes": [
          {
            "regex": "rejected=([0-9]+)",
            "group": 1
          }
        ],
        "accepted_regex": "share accepted",
        "rejected_regex": "share rejected|rejected",
        "error_regex": "panic|segmentation fault"
      }
    },
    "srbminer-herominers": {
      "url": "${SRB_WRAPPER_URL:-https://raw.githubusercontent.com/selkk-lab/pearl-fleet/main/scripts/srbminer-api-wrapper.sh}?v=20260608-srb335-stop1",
      "archive": "file",
      "binary": "srbminer-api-wrapper.sh",
      "env": {
        "MINER_POOL_URL": "de.pearl.herominers.com:1200",
        "SRB_API_PORT": "21550",
        "SRBMINER_URL": "https://github.com/doktor83/SRBMiner-Multi/releases/download/3.3.5/SRBMiner-Multi-3-3-5-Linux.tar.gz",
        "SRB_WATCHDOG_WARMUP_SECONDS": "180",
        "SRB_WATCHDOG_STALE_SECONDS": "420",
        "SRB_WATCHDOG_CHECK_INTERVAL": "30",
        "SRB_WATCHDOG_MIN_HASHRATE_TH_S": "0.1",
        "SRB_SHUTDOWN_TERM_SECONDS": "8",
        "SRB_SHUTDOWN_KILL_SECONDS": "4"
      },
      "args": [
        "--algorithm", "pearlhash",
        "--pool", "${MINER_POOL_URL}",
        "--wallet", "${MINER_WALLET}.${WORKER_NAME}",
        "--disable-cpu",
        "--log-file", "/proc/self/fd/1",
        "--api-enable",
        "--api-port", "${SRB_API_PORT}"
      ],
      "watchdog": {
        "mode": "log",
        "warmup_seconds": 180,
        "stale_seconds": 600,
        "hashrate_regexes": [
          {
            "regex": "Total:\\s*([0-9]+(?:[.][0-9]+)?)\\s*([KMGT]?H/s)",
            "value_group": 1,
            "unit_group": 2
          }
        ],
        "accepted_count_regexes": [
          {
            "regex": "accepted=([0-9]+)",
            "group": 1
          }
        ],
        "rejected_count_regexes": [
          {
            "regex": "rejected=([0-9]+)",
            "group": 1
          }
        ],
        "accepted_regex": "share accepted",
        "rejected_regex": "share rejected|rejected",
        "error_regex": "panic|segmentation fault"
      }
    },
    "pearlfortune": {
      "url": "https://github.com/pearlfortune/pearl-miner/releases/download/v1.1.7/pearlfortune-v1.1.7.tar.gz",
      "archive": "tar.gz",
      "binary": "miner",
      "env": {
        "PEARLFORTUNE_PROXY": "jp.pearlfortune.org:443"
      },
      "args": [
        "--proxy", "${PEARLFORTUNE_PROXY}",
        "--address", "${MINER_WALLET}",
        "--worker", "${WORKER_NAME}",
        "-gpu"
      ],
      "watchdog": {
        "mode": "process",
        "hashrate_regexes": [
          {
            "regex": "proof_per_sec=\\\"([0-9]+(?:[.][0-9]+)?)\\s*T/s\\\"",
            "value_group": 1,
            "unit": "TH/s"
          }
        ],
        "error_regex": "connection refused|failed|panic|segmentation fault"
      }
    }
  }
}
