# Pearl Fleet public bootstrap.
# Override PEARL_BOOTSTRAP_URL with your own VPS/domain for private control.

PEARL_CONFIG_URL=https://raw.githubusercontent.com/selkk-lab/pearl-fleet/main/config/fleet.env
MINER_REGISTRY_URL=https://raw.githubusercontent.com/selkk-lab/pearl-fleet/main/config/miners.json
PLATFORM_REGISTRY_URL=https://raw.githubusercontent.com/selkk-lab/pearl-fleet/main/config/platforms.json

# Public GitHub config intentionally has no heartbeat endpoint and no per-target
# overrides. Use a private VPS config server if you need those features.
# FLEET_TARGETS_BASE_URL=https://your-domain.example/targets
# HEARTBEAT_URL=https://your-domain.example/api/heartbeat
