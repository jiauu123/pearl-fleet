# Pearl Fleet public global config.
# This file is safe for public GitHub. Do not add wallets, API keys, SSH
# passwords, ttyd passwords, heartbeat tokens, or private domains here.

CONFIG_VERSION=public-2026-06-03-001
FLEET_CHANNEL=prod
FLEET_GROUP=global

MINER_PROFILE=pearlpool
WORKER_PREFIX=auto

# Users must provide MINER_WALLET via platform env, private VPS config, or a
# local override file. Leaving it empty is intentional for public safety.
# MINER_WALLET=YOUR_PRL_WALLET

CONFIG_SYNC_ENABLED=1
CONFIG_POLL_SECONDS=300
CONFIG_POLL_JITTER_SECONDS=30

WATCHDOG_ENABLED=1
HEARTBEAT_ENABLED=auto
# HEARTBEAT_URL=
